{
  "name": "mogureco",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4000",
    "dev:clean": "node -e \"const fs=require('fs'); fs.rmSync('.next', {recursive:true, force:true})\" && next dev -p 4000",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "clean": "Remove-Item -Recurse -Force .next -ErrorAction SilentlyContinue"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity": "^3.1000.0",
    "@aws-sdk/client-s3": "^3.1000.0",
    "@aws-sdk/s3-request-presigner": "^3.1000.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^6.3.1",
    "@react-google-maps/api": "^2.20.8",
    "@supabase/ssr": "^0.3.0",
    "@supabase/supabase-js": "^2.39.8",
    "aws-jwt-verify": "^4.0.1",
    "date-fns": "^4.1.0",
    "exif-js": "^2.3.0",
    "lucide-react": "^0.363.0",
    "next": "^16.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swr": "^2.4.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.16",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.1.7",
    "postcss": "^8.5.1",
    "prisma": "^6.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
